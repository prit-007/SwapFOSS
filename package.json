{
  "name": "swapfoss",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Free, open-source alternatives to the apps everyone already uses — site + carousel card generator.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "validate": "node scripts/ci/validate-tools.mjs",
    "carousel": "node scripts/generate-carousel.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.47.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  }
}
